// Prisma schema for To Be Take full-stack monorepo
// Sprint 1 & Super Admin Platform Foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// User Roles defining platform access levels (Super Admin, Admin, Seller, Buyer)
model UserRole {
  id          Int      @id @default(autoincrement()) @map("id")
  name        String   @unique @map("name") @db.VarChar(50)
  code        String   @unique @map("code") @db.VarChar(20)
  description String?  @map("description") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  @@map("user_roles")
}

/// Granular platform permissions for Role-Based Access Control (RBAC)
model Permission {
  id          Int      @id @default(autoincrement()) @map("id")
  code        String   @unique @map("code") @db.VarChar(50)
  name        String   @map("name") @db.VarChar(100)
  description String?  @map("description") @db.VarChar(255)
  category    String   @map("category") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Junction table mapping permissions to user roles
model RolePermission {
  id           Int      @id @default(autoincrement()) @map("id")
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  role       UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Internal departments for administrative and organizational hierarchy
model Department {
  id          Int      @id @default(autoincrement()) @map("id")
  name        String   @map("name") @db.VarChar(100)
  code        String   @unique @map("code") @db.VarChar(20)
  description String?  @map("description") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users User[]

  @@map("departments")
}

/// User accounts across all roles with security, audit, and soft-delete support
model User {
  id                  String     @id @default(uuid()) @map("id") @db.Uuid
  username            String     @unique @map("username") @db.VarChar(50)
  email               String     @unique @map("email") @db.VarChar(255)
  password            String     @map("password") @db.VarChar(255)
  firstName           String     @map("first_name") @db.VarChar(100)
  lastName            String     @map("last_name") @db.VarChar(100)
  roleId              Int        @map("role_id")
  status              UserStatus @default(ACTIVE) @map("status")
  isEmailVerified     Boolean    @default(false) @map("is_email_verified")
  isMobileVerified    Boolean    @default(false) @map("is_mobile_verified")
  lastLogin           DateTime?  @map("last_login")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  createdBy           String?    @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedBy           String?    @map("updated_by") @db.Uuid
  updatedAt           DateTime   @updatedAt @map("updated_at")
  isDeleted           Boolean    @default(false) @map("is_deleted")
  deletedAt           DateTime?  @map("deleted_at")
  departmentId        Int?       @map("department_id")
  designation         String?    @map("designation") @db.VarChar(100)
  storeName           String?    @map("store_name") @db.VarChar(100)
  businessCategory    String?    @map("business_category") @db.VarChar(100)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  isLocked            Boolean    @default(false) @map("is_locked")
  lockedUntil         DateTime?  @map("locked_until")

  // Relations
  role              UserRole          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department        Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator           User?             @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers      User[]            @relation("UserCreatedBy")
  updater           User?             @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedUsers      User[]            @relation("UserUpdatedBy")
  auditLogs         AuditLog[]
  platformSettings  PlatformSetting[]
  sessions          UserSession[]
  sellerApprovals   SellerApproval[]  @relation("SellerApprovals")
  reviewedApprovals SellerApproval[]  @relation("ReviewedApprovals")
  sellerProducts    Product[]         @relation("SellerProducts")
  customerOrders    Order[]           @relation("CustomerOrders")
  sellerOrderItems  OrderItem[]       @relation("SellerOrderItems")
  sellerCommissions CommissionRecord[] @relation("SellerCommissions")
  sellerPayouts     SellerPayout[]    @relation("SellerPayouts")
  customerReturns   OrderReturn[]     @relation("CustomerReturns")
  sellerReturns     OrderReturn[]     @relation("SellerReturns")
  customerReviews   ProductReview[]        @relation("CustomerReviews")
  sellerReviews     ProductReview[]        @relation("SellerReviews")
  addresses         UserAddress[]          @relation("UserAddresses")
  cartItems         CartItem[]             @relation("UserCartItems")
  wishlistItems     WishlistItem[]         @relation("UserWishlistItems")
  userNotifications CustomerNotification[] @relation("UserNotifications")

  @@index([roleId])
  @@index([departmentId])
  @@index([status])
  @@index([isDeleted])
  @@index([email, isDeleted])
  @@index([username, isDeleted])
  @@map("users")
}

/// Administrative and security audit logs
model AuditLog {
  id         String   @id @default(uuid()) @map("id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(100)
  actorEmail String   @map("actor_email") @db.VarChar(255)
  actorRole  String   @map("actor_role") @db.VarChar(50)
  action     String   @map("action") @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.VarChar(100)
  status     String   @default("SUCCESS") @map("status") @db.VarChar(20)
  details    String?  @map("details") @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Dynamic platform-level configuration settings
model PlatformSetting {
  id          Int      @id @default(autoincrement()) @map("id")
  key         String   @unique @map("key") @db.VarChar(100)
  value       String   @map("value") @db.Text
  description String?  @map("description") @db.VarChar(255)
  category    String   @default("GENERAL") @map("category") @db.VarChar(50)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([category])
  @@map("platform_settings")
}

/// User active login sessions for security and session revocation
model UserSession {
  id             String   @id @default(uuid()) @map("id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  sessionToken   String   @unique @map("session_token") @db.VarChar(255)
  ipAddress      String?  @map("ip_address") @db.VarChar(50)
  userAgent      String?  @map("user_agent") @db.VarChar(255)
  deviceInfo     String?  @map("device_info") @db.VarChar(100)
  isValid        Boolean  @default(true) @map("is_valid")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("user_sessions")
}

/// Seller onboarding approval requests and status history
model SellerApproval {
  id              String         @id @default(uuid()) @map("id") @db.Uuid
  sellerId        String         @map("seller_id") @db.Uuid
  status          ApprovalStatus @default(PENDING) @map("status")
  reviewedBy      String?        @map("reviewed_by") @db.Uuid
  notes           String?        @map("notes") @db.Text
  rejectionReason String?        @map("rejection_reason") @db.VarChar(255)
  submittedAt     DateTime       @default(now()) @map("submitted_at")
  reviewedAt      DateTime?      @map("reviewed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  seller   User  @relation("SellerApprovals", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewedApprovals", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([status])
  @@map("seller_approvals")
}

// ==========================================
// Commerce Core & Marketplace Modules
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
  REJECTED
}

enum ShippingStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum NotificationType {
  SELLER_APPROVAL
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  LOW_STOCK
  RETURN_REQUEST
  PAYMENT_ALERT
  SYSTEM_ALERT
}

/// Hierarchical product categories
model Category {
  id           Int        @id @default(autoincrement()) @map("id")
  name         String     @map("name") @db.VarChar(100)
  slug         String     @unique @map("slug") @db.VarChar(120)
  description  String?    @map("description") @db.VarChar(255)
  parentId     Int?       @map("parent_id")
  isActive     Boolean    @default(true) @map("is_active")
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

/// Marketplace catalog products
model Product {
  id              String        @id @default(uuid()) @map("id") @db.Uuid
  sellerId        String        @map("seller_id") @db.Uuid
  categoryId      Int?          @map("category_id")
  name            String        @map("name") @db.VarChar(200)
  slug            String        @unique @map("slug") @db.VarChar(220)
  sku             String        @unique @map("sku") @db.VarChar(100)
  description     String?       @map("description") @db.Text
  price           Decimal       @map("price") @db.Decimal(12, 2)
  compareAtPrice  Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice       Decimal?      @map("cost_price") @db.Decimal(12, 2)
  status          ProductStatus @default(PENDING_REVIEW) @map("status")
  moderationNotes String?       @map("moderation_notes") @db.VarChar(500)
  images          String[]      @default([]) @map("images")
  isDeleted       Boolean       @default(false) @map("is_deleted")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  seller     User            @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory  InventoryItem?
  orderItems    OrderItem[]     @relation()
  reviews       ProductReview[] @relation()
  cartItems     CartItem[]      @relation("ProductCartItems")
  wishlistItems WishlistItem[]  @relation("ProductWishlistItems")

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([isDeleted])
  @@map("products")
}

/// Product stock and inventory levels
model InventoryItem {
  id                String         @id @default(uuid()) @map("id") @db.Uuid
  productId         String         @unique @map("product_id") @db.Uuid
  sku               String         @unique @map("sku") @db.VarChar(100)
  stockQuantity     Int            @default(0) @map("stock_quantity")
  reservedQuantity  Int            @default(0) @map("reserved_quantity")
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  location          String?        @map("location") @db.VarChar(100)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs    InventoryLog[]

  @@index([stockQuantity])
  @@map("inventory_items")
}

/// Audit trail of stock level changes
model InventoryLog {
  id               String        @id @default(uuid()) @map("id") @db.Uuid
  inventoryItemId  String        @map("inventory_item_id") @db.Uuid
  changeType       String        @map("change_type") @db.VarChar(50)
  quantityChange   Int           @map("quantity_change")
  previousQuantity Int           @map("previous_quantity")
  newQuantity      Int           @map("new_quantity")
  reason           String?       @map("reason") @db.VarChar(255)
  actorId          String?       @map("actor_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_logs")
}

/// Customer orders placed in marketplace
model Order {
  id                 String               @id @default(uuid()) @map("id") @db.Uuid
  orderNumber        String               @unique @map("order_number") @db.VarChar(50)
  customerId         String               @map("customer_id") @db.Uuid
  status             OrderStatus          @default(PENDING) @map("status")
  paymentStatus      PaymentStatus        @default(PENDING) @map("payment_status")
  currency           String               @default("PKR") @map("currency") @db.VarChar(10)
  subtotal           Decimal              @map("subtotal") @db.Decimal(12, 2)
  shippingTotal      Decimal              @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal              @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal      Decimal              @default(0) @map("discount_total") @db.Decimal(12, 2)
  total              Decimal              @map("total") @db.Decimal(12, 2)
  shippingAddress    String?              @map("shipping_address") @db.Text
  billingAddress     String?              @map("billing_address") @db.Text
  customerNotes      String?              @map("customer_notes") @db.Text
  adminNotes         String?              @map("admin_notes") @db.Text
  cancellationReason String?              @map("cancellation_reason") @db.VarChar(255)
  cancelledAt        DateTime?            @map("cancelled_at")
  confirmedAt        DateTime?            @map("confirmed_at")
  shippedAt          DateTime?            @map("shipped_at")
  deliveredAt        DateTime?            @map("delivered_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  // Relations
  customer      User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  shipments     Shipment[]
  returns       OrderReturn[]
  commissions   CommissionRecord[]
  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// Line items belonging to an order
model OrderItem {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  sku         String   @map("sku") @db.VarChar(100)
  quantity    Int      @map("quantity")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  seller  User     @relation("SellerOrderItems", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
  @@map("order_items")
}

/// History log of order status transitions
model OrderStatusHistory {
  id         String       @id @default(uuid()) @map("id") @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  notes      String?      @map("notes") @db.VarChar(255)
  actorId    String?      @map("actor_id") @db.Uuid
  actorName  String?      @map("actor_name") @db.VarChar(100)
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

/// Internal payment records for orders
model Payment {
  id                   String        @id @default(uuid()) @map("id") @db.Uuid
  orderId              String        @map("order_id") @db.Uuid
  transactionReference String        @unique @map("transaction_reference") @db.VarChar(100)
  paymentMethod        String        @map("payment_method") @db.VarChar(50)
  amount               Decimal       @map("amount") @db.Decimal(12, 2)
  currency             String        @default("PKR") @map("currency") @db.VarChar(10)
  status               PaymentStatus @default(PENDING) @map("status")
  failureReason        String?       @map("failure_reason") @db.VarChar(255)
  metadata             String?       @map("metadata") @db.Text
  paidAt               DateTime?     @map("paid_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

/// Marketplace platform commission ledger per order
model CommissionRecord {
  id             String        @id @default(uuid()) @map("id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  payoutId       String?       @map("payout_id") @db.Uuid
  orderAmount    Decimal       @map("order_amount") @db.Decimal(12, 2)
  commissionRate Decimal       @map("commission_rate") @db.Decimal(5, 2)
  platformFee    Decimal       @map("platform_fee") @db.Decimal(12, 2)
  sellerEarnings Decimal       @map("seller_earnings") @db.Decimal(12, 2)
  status         String        @default("PENDING") @map("status") @db.VarChar(30)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller User          @relation("SellerCommissions", fields: [sellerId], references: [id], onDelete: Restrict)
  payout SellerPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerId])
  @@index([payoutId])
  @@index([status])
  @@map("commission_records")
}

/// Seller earnings payouts workflow ledger
model SellerPayout {
  id           String             @id @default(uuid()) @map("id") @db.Uuid
  payoutNumber String             @unique @map("payout_number") @db.VarChar(50)
  sellerId     String             @map("seller_id") @db.Uuid
  amount       Decimal            @map("amount") @db.Decimal(12, 2)
  currency     String             @default("PKR") @map("currency") @db.VarChar(10)
  status       PayoutStatus       @default(PENDING) @map("status")
  periodStart  DateTime?          @map("period_start")
  periodEnd    DateTime?          @map("period_end")
  processedAt  DateTime?          @map("processed_at")
  processedBy  String?            @map("processed_by") @db.Uuid
  notes        String?            @map("notes") @db.Text
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  // Relations
  seller      User               @relation("SellerPayouts", fields: [sellerId], references: [id], onDelete: Restrict)
  commissions CommissionRecord[]

  @@index([sellerId])
  @@index([status])
  @@map("seller_payouts")
}

/// Order returns and refund management
model OrderReturn {
  id           String        @id @default(uuid()) @map("id") @db.Uuid
  returnNumber String        @unique @map("return_number") @db.VarChar(50)
  orderId      String        @map("order_id") @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  sellerId     String        @map("seller_id") @db.Uuid
  reason       String        @map("reason") @db.VarChar(255)
  status       ReturnStatus  @default(REQUESTED) @map("status")
  refundStatus PaymentStatus @default(PENDING) @map("refund_status")
  refundAmount Decimal       @map("refund_amount") @db.Decimal(12, 2)
  adminNotes   String?       @map("admin_notes") @db.Text
  reviewedBy   String?       @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  // Relations
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation("CustomerReturns", fields: [customerId], references: [id], onDelete: Restrict)
  seller   User  @relation("SellerReturns", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@map("order_returns")
}

/// Shipping and tracking records
model Shipment {
  id                String         @id @default(uuid()) @map("id") @db.Uuid
  orderId           String         @map("order_id") @db.Uuid
  carrier           String         @map("carrier") @db.VarChar(100)
  trackingNumber    String         @map("tracking_number") @db.VarChar(100)
  trackingUrl       String?        @map("tracking_url") @db.VarChar(255)
  status            ShippingStatus @default(PENDING) @map("status")
  estimatedDelivery DateTime?      @map("estimated_delivery")
  shippedDate       DateTime?      @map("shipped_date")
  deliveredDate     DateTime?      @map("delivered_date")
  notes             String?        @map("notes") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

/// Product ratings and customer reviews
model ProductReview {
  id              String       @id @default(uuid()) @map("id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  customerId      String       @map("customer_id") @db.Uuid
  sellerId        String       @map("seller_id") @db.Uuid
  rating          Int          @map("rating") @db.SmallInt
  title           String?      @map("title") @db.VarChar(150)
  comment         String       @map("comment") @db.Text
  status          ReviewStatus @default(PENDING) @map("status")
  isReported      Boolean      @default(false) @map("is_reported")
  reportReason    String?      @map("report_reason") @db.VarChar(255)
  moderationNotes String?      @map("moderation_notes") @db.Text
  moderatedBy     String?      @map("moderated_by") @db.Uuid
  moderatedAt     DateTime?    @map("moderated_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Restrict)
  seller   User    @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@index([isReported])
  @@map("product_reviews")
}

/// Admin internal notification center
model AdminNotification {
  id        String           @id @default(uuid()) @map("id") @db.Uuid
  type      NotificationType @map("type")
  title     String           @map("title") @db.VarChar(150)
  message   String           @map("message") @db.Text
  targetUrl String?          @map("target_url") @db.VarChar(255)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  metadata  String?          @map("metadata") @db.Text
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("admin_notifications")
}

/// Customer saved shipping and billing addresses
model UserAddress {
  id            String   @id @default(uuid()) @map("id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String   @default("Home") @map("label") @db.VarChar(50)
  recipientName String   @map("recipient_name") @db.VarChar(100)
  phone         String   @map("phone") @db.VarChar(25)
  streetAddress String   @map("street_address") @db.VarChar(255)
  area          String?  @map("area") @db.VarChar(100)
  city          String   @map("city") @db.VarChar(100)
  province      String   @map("province") @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  country       String   @default("Pakistan") @map("country") @db.VarChar(50)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

/// Customer shopping cart items
model CartItem {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1) @map("quantity")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user    User    @relation("UserCartItems", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductCartItems", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_items")
}

/// Customer saved wishlist items
model WishlistItem {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation("UserWishlistItems", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductWishlistItems", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

/// Customer specific notifications
model CustomerNotification {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @default("ORDER") @map("type") @db.VarChar(50)
  title     String    @map("title") @db.VarChar(150)
  message   String    @map("message") @db.Text
  targetUrl String?   @map("target_url") @db.VarChar(255)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  metadata  String?   @map("metadata") @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("customer_notifications")
}
