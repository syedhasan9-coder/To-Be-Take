{
  "name": "@tobetake/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo React Native Mobile Application for To Be Take",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint \"**/*.{ts,tsx}\" --ignore-pattern node_modules/",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .expo"
  },
  "dependencies": {
    "@tobetake/shared-types": "workspace:*",
    "expo": "~51.0.38",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@tobetake/eslint-config": "workspace:*",
    "@tobetake/tsconfig": "workspace:*",
    "@types/react": "^18.3.18",
    "babel-preset-expo": "~11.0.15",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  }
}
