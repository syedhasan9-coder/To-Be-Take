PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/to_be_take_dev?schema=public"

# Authentication & Session Secrets (Replace with secure random secrets in production)
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-jwt-secret-key-min-32-chars

# Super Admin Bootstrap (Used during initial migration/seeding only)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@tobetake.dev
SUPER_ADMIN_PASSWORD=change-me-secure-password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Admin Registration Security Guard (Production)
ADMIN_REGISTRATION_SECRET=change-this-in-production
ALLOW_PUBLIC_ADMIN_REGISTRATION=false

# Seller Registration Security Guard (Production)
SELLER_REGISTRATION_SECRET=change-this-in-production
ALLOW_PUBLIC_SELLER_REGISTRATION=false

# CORS Whitelist (Comma-separated origins for production)
CORS_ORIGINS=https://tobetake.com,https://admin.tobetake.com

# Rate Limiting & Throttler Configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_TTL=60
ADMIN_RATE_LIMIT_MAX=30

# Security & Development Flags (Strictly false in production/staging)
ALLOW_DEV_SUPERADMIN_FALLBACK=false
