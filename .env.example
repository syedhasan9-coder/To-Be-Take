# ==============================================================================
# To Be Take - Environment Variables Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_DB=to_be_take_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/to_be_take_dev?schema=public"

# API Service Configuration (apps/api)
API_PORT=4000
NODE_ENV=development

# Super Admin Bootstrap (Used during database seed)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@tobetake.dev
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Admin Registration Security Guard (Production)
# In production, set ADMIN_REGISTRATION_SECRET to require x-admin-registration-key header
ADMIN_REGISTRATION_SECRET=change-this-in-production
ALLOW_PUBLIC_ADMIN_REGISTRATION=false

# Seller Registration Security Guard (Production)
# In production, set SELLER_REGISTRATION_SECRET to require x-seller-registration-key header
SELLER_REGISTRATION_SECRET=change-this-in-production
ALLOW_PUBLIC_SELLER_REGISTRATION=false

# Web Application Configuration (apps/web)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Mobile Application Configuration (apps/mobile)
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ==============================================================================
# Payment Gateway Configuration (Easypaisa Merchant)
# Official merchant credentials must be acquired from Telenor Easypaisa.
# Never commit real credentials to version control.
# ==============================================================================
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_POST_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf
EASYPAISA_SANDBOX_POST_URL=https://easypaystg.easypaisa.com.pk/easypay/Index.jsf
EASYPAISA_SANDBOX_MODE=true
EASYPAISA_CALLBACK_URL=http://localhost:4000/api/payments/easypaisa/callback

# ==============================================================================
# Courier Logistics Integrations (TCS Express & Leopards Courier)
# Official merchant API credentials for automated consignment booking.
# When missing, the platform securely operates in manual AWB booking mode.
# ==============================================================================
TCS_API_KEY=
TCS_COST_CENTER_CODE=
TCS_ACCOUNT_NO=
TCS_USERNAME=
TCS_PASSWORD=
TCS_BASE_URL=https://apis.tcsexpress.com/cod/v1

LEOPARDS_API_KEY=
LEOPARDS_API_PASSWORD=
LEOPARDS_ORIGIN_CITY=Lahore
LEOPARDS_BASE_URL=https://merchantapi.leopardscourier.com/api
