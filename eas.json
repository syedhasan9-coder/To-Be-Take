{
  "cli": {
    "version": ">= 24.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.18.0",
      "pnpm": "9.15.4",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.2.5:4000/api"
      }
    },
    "preview": {
      "node": "20.18.0",
      "pnpm": "9.15.4",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.2.5:4000/api"
      }
    },
    "production": {
      "node": "20.18.0",
      "pnpm": "9.15.4",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.2.5:4000/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
